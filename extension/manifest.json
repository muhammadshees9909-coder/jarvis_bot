{
  "manifest_version": 3,
  "name": "JARVIS Glass Assistant",
  "version": "1.0.0",
  "description": "A floating glassmorphism browser assistant for JARVIS Forexcast Intelligence.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.trycloudflare.com/*",
    "https://*.ngrok-free.app/*",
    "https://*.ngrok-free.dev/*",
    "https://*.ngrok.app/*",
    "https://*.ngrok.io/*",
    "https://*.loca.lt/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}